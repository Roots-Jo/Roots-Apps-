{
  /*
   * RTDB rules cascade downward: granting .read/.write at a level also grants it to every
   * child, and a deeper rule CANNOT revoke it. So there is deliberately no rule at the root —
   * access is granted per top-level path instead, which is what lets system_config stay
   * private while the app paths remain open.
   *
   * These apps do not use Firebase Auth (login is a plaintext password compare in the client
   * against /users), so the application paths below must stay open or every app breaks.
   * That is a known gap, not an endorsement: /users holds plaintext passwords and is world
   * readable. Closing it properly requires migrating the login flow to Firebase Auth.
   *
   * The Admin SDK used by Cloud Functions bypasses these rules, so the functions can still
   * read and write system_config/omniful_auth normally.
   */
  "rules": {
    "system_config": {
      ".read": false,
      ".write": false
    },

    "users":              { ".read": true, ".write": true },

    /*
     * Refresh bookkeeping: when the last on-demand and scheduled COD fetches ran, so the
     * dashboards can show it and the cooldown holds across function instances. Written by
     * the Admin SDK, which bypasses these rules, so the clients only need to read it —
     * leaving it read-only also stops a client from clearing the stamp to dodge the
     * cooldown.
     */
    "cod_sync":           { ".read": true, ".write": false },

    /*
     * Per-order stage timeline parsed from Omniful's order log: pick and pack times, who
     * did each, and how long the order sat On Hold. Written only by the Admin SDK, which
     * bypasses these rules, so clients read and never write — a client write here would
     * corrupt operator metrics with no audit trail.
     */
    "cod_order_stages":   { ".read": true, ".write": false },

    "cod_daily_orders":   { ".read": true, ".write": true },
    "cod_reconciliation": { ".read": true, ".write": true },
    "cases_tracker":      { ".read": true, ".write": true },
    "shifts":             { ".read": true, ".write": true },
    "collection_tracker": { ".read": true, ".write": true },
    "trackers":           { ".read": true, ".write": true }
  }
}
