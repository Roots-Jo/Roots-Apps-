# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*

# Firebase cache
.firebase/

# Firebase config
# Deny JSON by default so a stray service-account key can never be committed, then
# explicitly re-include the files that must be versioned. Without these negations the
# app's own reference data (mapping.json, deliveries.json) was silently untracked and
# existed only on whichever machine last edited it.
*.json
!package.json
!package-lock.json
!firebase.json
!.firebaserc
!database.rules.json
!public/data/mapping.json
!public/data/deliveries.json
!public/data/statuses.json

# Service-account / credential files must never be committed
*service-account*.json
*serviceAccount*.json
*-key.json
*credentials*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# dataconnect generated files
.dataconnect

functions/.env
