                    "cleanUrls":  true,
                    "trailingSlash":  false
                },
    "functions":  [
                      {
                          "ignore":  [
                                         "node_modules",
                                         ".git",
                                         "firebase-debug.log",
                                         "firebase-debug.*.log",
                                         "*.local"
